@article{veres2024fireblight,
  abbr        = {Sensors},
  bibtex_show = {true},
  title       = {An Evaluation of Multi-Channel Sensors and Density Estimation Learning for Detecting Fire Blight Disease in Pear Orchards},
  author      = {Veres, Matthew and Tarry, Cole and Grigg-McGuffin, Kristy and McFadden-Smith, Wendy and Moussa, Medhat},
  journal     = {Sensors},
  volume      = {24},
  number      = {16},
  pages       = {5387},
  year        = {2024},
  publisher   = {MDPI},
  doi         = {10.3390/s24165387},
  html        = {https://www.mdpi.com/1424-8220/24/16/5387},
  pdf         = {https://www.mdpi.com/1424-8220/24/16/5387/pdf},
  preview     = {fire_blight.png},
  selected    = {true},
  abstract    = {Fire blight is an infectious disease found in apple and pear orchards. While managing the disease is critical to maintaining orchard health, identifying symptoms early is a challenging task which requires trained expert personnel. This paper presents an inspection technique that targets individual symptoms via deep learning and density estimation, and leverages both RGB and NIR sensors.}
}

@article{haggag2024tomato,
  abbr            = {Agriculture},
  bibtex_show     = {true},
  title           = {Object Detection in Tomato Greenhouses: A Study on Model Generalization},
  author          = {Haggag, Sammar and Veres, Matthew and Tarry, Cole and Moussa, Medhat},
  journal         = {Agriculture},
  volume          = {14},
  number          = {2},
  pages           = {173},
  year            = {2024},
  publisher       = {MDPI},
  doi             = {10.3390/agriculture14020173},
  html            = {https://www.mdpi.com/2077-0472/14/2/173},
  pdf             = {https://www.mdpi.com/2077-0472/14/2/173/pdf},
  additional_info = {. [Related News Coverage](https://kitchener.ctvnews.ca/smart-robot-could-transform-produce-picking-farms-1.6807981)},
  preview         = {tomato_greenhouse.jpg},
  selected        = {true},
  abstract        = {Commercial greenhouses have very challenging environments and objects not commonly found in traditional image datasets. In this work, we collect four datasets from different greenhouses, under different conditions, and evaluate how well a vision system based on Mask-RCNN generalizes across different sources of variation as a pre-cursor to automated harvesting tasks.}
}

@article{idzik2023gear,
  abbr        = {Sensors},
  bibtex_show = {true},
  title       = {A Real-Time Inspection System for Industrial Helical Gears},
  author      = {Idzik, Thomas and Veres, Matthew and Tarry, Cole and Moussa, Medhat},
  journal     = {Sensors},
  volume      = {23},
  number      = {20},
  pages       = {8541},
  year        = {2023},
  publisher   = {MDPI},
  doi         = {10.3390/s23208541},
  html        = {https://www.mdpi.com/1424-8220/23/20/8541},
  pdf         = {https://www.mdpi.com/1424-8220/23/20/8541/pdf},
  preview     = {gear_inspection.png},
  selected    = {true},
  abstract    = {In order for automated gear inspection systems to run in-situ within a factory, a system must be able to perform scans quickly and detect multiple types of defects. In this work we outline a set of improvements to a system that allows us to inspect a gear within 7.5s and detect three types of defects using deep learning.}
}

@article{allam2021teeth,
  abbr        = {Sensors},
  bibtex_show = {true},
  title       = {Detecting Teeth Defects on Automotive Gears Using Deep Learning},
  author      = {Allam, Abdelrahman and Moussa, Medhat and Tarry, Cole and Veres, Matthew},
  journal     = {Sensors},
  volume      = {21},
  number      = {24},
  pages       = {8480},
  year        = {2021},
  publisher   = {MDPI},
  doi         = {10.3390/s21248480},
  html        = {https://www.mdpi.com/1424-8220/21/24/8480},
  pdf         = {https://www.mdpi.com/1424-8220/21/24/8480/pdf},
  preview     = {gear_teeth_defects.png},
  selected    = {true},
  abstract    = {Defects produced on gears can exist anywhere on the gears surface. We present a proof-of-concept for detecting a single type of defect based on Faster-RCNN, and develop a domain knowledge constraint for minimizing false positive and false negative predictions.}
}

@article{veres2020grasp,
  abbr        = {IEEE RA-L},
  bibtex_show = {true},
