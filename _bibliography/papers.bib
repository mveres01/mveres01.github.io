@article{veres2017modeling,
  abbr        = {IEEE RA-L},
  bibtex_show = {true},
  title       = {Modeling Grasp Motor Imagery through Deep Conditional Generative Models},
  author      = {Veres, Matthew and Moussa, Medhat and Taylor, Graham W.},
  journal     = {IEEE Robotics and Automation Letters},
  volume      = {2},
  number      = {2},
  pages       = {757--764},
  year        = {2017},
  publisher   = {IEEE},
  doi         = {10.1109/LRA.2017.2650153},
  html        = {https://ieeexplore.ieee.org/abstract/document/7814247},
  preview     = {motor_imagery.png},
  selected    = {true},
  abstract    = {Objects can be grasped in many different ways -- there is no one single correct solution. In this work, we show how generative models can be used to generate grasps for a multi-finger gripper grasping objects in a simulation, with results suggesting multi-modal grasping strategies are possible.}
}

@article{veres2017integrated,
  abbr        = {arXiv},
  bibtex_show = {true},
  title       = {An Integrated Simulator and Dataset that Combines Grasping and Vision for Deep Learning},
  author      = {Veres, Matthew and Moussa, Medhat and Taylor, Graham W.},
  journal     = {arXiv preprint arXiv:1702.02103},
  year        = {2017},
  arxiv       = {1702.02103},
  html        = {https://arxiv.org/abs/1702.02103},
  code        = {https://github.com/mveres01/multi-contact-grasping},
  preview     = {grasp_simulator.png},
  selected    = {true},
  abstract    = {In order to train a robot to grasp objects via deep learning, we need to collect lots of data. This work describes the development of a simulator for collecting multi-fingered grasps via a grasp-and-lift process, while simultaneously collecting different types of visual sensory information.}
}

@inproceedings{veres2015soil,
